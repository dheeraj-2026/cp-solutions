{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build current file",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17", "-g", "-O0",
        "-Wall", "-Wextra", "-Wshadow",
        "-DLOCAL",
        "${file}",
        "-o", "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}